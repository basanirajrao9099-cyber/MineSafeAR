    <string name="ar_tracking_insufficient_light">ट्रैकिंग के लिए बहुत अंधेरा है। अधिक रोशनी चाहिए।</string>
    <string name="ar_tracking_excessive_motion">बहुत तेज़ हिल रहा है। धीरे करें।</string>
    <string name="ar_tracking_insufficient_features">इस सतह पर पर्याप्त विवरण नहीं है। किसी अधिक बनावट वाली सतह पर लक्ष्य करें।</string>
    <string name="ar_tracking_camera_unavailable">कैमरा किसी अन्य ऐप द्वारा उपयोग में है।</string>

    <!-- ARCore availability -->
    <string name="ar_core_unavailable_title">एआर प्रशिक्षण शुरू नहीं हो सका</string>
    <string name="ar_core_device_unsupported">यह फ़ोन एआर का समर्थन नहीं करता। लिखित मॉड्यूल और आपके प्रमाणपत्र यहाँ काम करते रहेंगे — एआर ड्रिल पूरी करने के लिए अपने पर्यवेक्षक से समर्थित फ़ोन माँगें।</string>
    <string name="ar_core_missing">एआर प्रशिक्षण के लिए Google Play Services for AR ज़रूरी है, जो इस फ़ोन में इंस्टॉल नहीं है। इसे इंस्टॉल करने के लिए नेटवर्क चाहिए, इसलिए शिफ़्ट से पहले सतह कार्यालय में यह कर लें।</string>
    <string name="ar_core_outdated">इस फ़ोन में Google Play Services for AR पुराना है। जहाँ नेटवर्क है, वहाँ सतह कार्यालय में इसे अपडेट करें।</string>

    <!--
      Fire &amp; Explosion Response module.

      The cylinder colour named in each extinguisher string is the identifying
      feature the trainee is being taught, so it is kept in the translation. Which
      colour goes with which type must not be changed: काला = CO2, क्रीम = foam,
      लाल = water (IS 15683 / EN 3).
    -->
    <string name="fire_module_title">आग और विस्फोट प्रतिक्रिया</string>
    <string name="fire_module_card_summary">चालू बिजली उपकरण में लगी आग के लिए सही अग्निशामक यंत्र चुनें, फिर चिह्नों के अनुसार बाहर निकलें।</string>
    <string name="fire_module_fire_description">जल रहा है: कन्वेयर मोटर का स्टार्टर पैनल। बिजली की सप्लाई अब भी चालू है।</string>

    <!-- Briefing -->
    <string name="fire_module_briefing_title">परिदृश्य विवरण</string>
    <string name="fire_module_instruction_1">इस कमरे में आग लग गई है। कन्वेयर मोटर को बिजली देने वाला स्टार्टर पैनल जल रहा है और उसकी सप्लाई बंद नहीं की गई है, इसलिए पैनल के अंदर सब कुछ चालू मानें।</string>
    <string name="fire_module_instruction_2">पास में तीन अग्निशामक यंत्र रखे हैं। चालू बिजली उपकरण की आग पर इनमें से केवल एक सुरक्षित है; बाकी दो करंट को पकड़ने वाले तक वापस पहुँचा देंगे। सही यंत्र को उसके सिलेंडर के रंग से पहचानें।</string>
    <string name="fire_module_instruction_3">इसके बाद बाहर निकलें। आप जिस कमरे में खड़े हैं, उसके असली निकास पर निकास चिह्न लगाएँ, और उसी तक जाने वाला मार्ग चुनें।</string>
    <string name="fire_module_start_drill">अभ्यास शुरू करें</string>

    <!-- Placing the scene -->
    <string name="fire_module_place_exit_sign">फ़ोन को इस कमरे के असली निकास के पास के फ़र्श पर लक्ष्य करें, फिर निकास चिह्न लगाने के लिए टैप करें।</string>
    <string name="fire_module_place_extinguisher">फ़र्श की किसी खाली जगह पर टैप करें। वहाँ एक अग्निशामक यंत्र दिखेगा, और आपको नहीं बताया जाएगा कि कौन सा है।</string>
    <string name="fire_module_place_route">निकास मार्ग का तीर रखने के लिए फ़र्श पर टैप करें। तीनों तीरों को अलग-अलग दिशाओं में फैलाएँ।</string>
    <string name="fire_module_place_progress">%2$d में से %1$d रखे गए</string>
    <string name="fire_module_hint_too_close">पहले रखी वस्तु के बहुत पास है। वस्तुओं के बीच लगभग एक मीटर की दूरी रखें।</string>
    <string name="fire_module_prompt_wait">फ़ोन को स्थिर रखें।</string>

    <!-- Making the decisions -->
    <string name="fire_module_choose_extinguisher_prompt">जिस अग्निशामक यंत्र का उपयोग आप इस आग पर करेंगे, उस पर टैप करें।</string>
    <string name="fire_module_choose_route_prompt">जो तीर निकास चिह्न की ओर जाता है, उस पर टैप करें।</string>
    <string name="fire_module_hint_tap_extinguisher">यह अग्निशामक यंत्र नहीं है। तीनों सिलेंडरों में से किसी एक पर टैप करें।</string>
    <string name="fire_module_hint_tap_route">निकास मार्ग के तीरों में से किसी एक पर टैप करें।</string>
    <string name="fire_module_hint_exit_sign_later">वह निकास आपको चाहिए होगा, लेकिन पहले अग्निशामक का निर्णय लेना है।</string>

    <!-- What each object is, revealed in feedback and results -->
    <string name="fire_module_item_extinguisher_co2">CO₂ अग्निशामक (काला)</string>
    <string name="fire_module_item_extinguisher_foam">फोम अग्निशामक (क्रीम)</string>
    <string name="fire_module_item_extinguisher_water">पानी वाला अग्निशामक (लाल)</string>
    <string name="fire_module_item_exit_sign">निकास चिह्न</string>
    <string name="fire_module_item_exit_arrow">निकास मार्ग का तीर</string>

    <!-- Feedback overlays -->
    <string name="fire_module_feedback_correct_title">सही</string>
    <string name="fire_module_feedback_wrong_title">यह क्यों ग़लत है</string>
    <string name="fire_module_feedback_hint_title">यह नहीं</string>
    <string name="fire_module_feedback_continue">आगे बढ़ें</string>
    <string name="fire_module_extinguisher_correct">काला CO₂ अग्निशामक। कार्बन डाइऑक्साइड बिजली का सुचालक नहीं है और कोई अवशेष नहीं छोड़ती, इसलिए यह चालू उपकरण पर सुरक्षित है और पैनल को भी ख़राब नहीं करेगी।</string>
    <string name="fire_module_wrong_water">लाल, पानी वाला अग्निशामक। पानी बिजली का सुचालक है, इसलिए चालू पैनल पर डाली गई धार करंट को सीधे आप तक वापस ले आती है। पानी लकड़ी, काग़ज़ और कपड़े की आग के लिए है, बिजली की आग के लिए कभी नहीं।</string>
    <string name="fire_module_wrong_foam">क्रीम रंग का फोम अग्निशामक। फोम में मुख्यतः पानी होता है, इसलिए वह भी करंट प्रवाहित करता है। फोम ज्वलनशील तरल पदार्थों — ईंधन, तेल, सॉल्वेंट — के लिए है, चालू उपकरण के लिए नहीं।</string>
    <string name="fire_module_wrong_generic">यह अग्निशामक इस प्रकार की आग के लिए नहीं है।</string>
    <string name="fire_module_route_wrong">यह तीर निकास चिह्न से दूर ले जाता है। धुएँ में आपको दरवाज़ा दिखाई नहीं देगा, इसलिए चिह्न ही एकमात्र सहारा हैं, और उन्हें छोड़ने वाला रास्ता बंद गली है।</string>

