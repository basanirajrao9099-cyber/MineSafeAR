    <string name="certificates_empty">अभी कोई प्रमाणपत्र नहीं है। प्रशिक्षण मॉड्यूल उत्तीर्ण करें, फिर यहाँ प्रमाणपत्र बनाएँ।</string>
    <string name="certificates_no_results">इस डिवाइस पर अभी कोई मॉड्यूल परिणाम नहीं है। पहले एक प्रशिक्षण मॉड्यूल पूरा करें।</string>
    <string name="certificates_eligible">प्रमाणन के लिए योग्य। औसत स्कोर %1$d।</string>
    <string name="certificates_not_eligible">औसत स्कोर %1$d। प्रमाणन के लिए %2$d चाहिए।</string>
    <string name="certificates_modules_counted">%1$d मॉड्यूल में से प्रत्येक का सर्वश्रेष्ठ प्रयास गिना गया है।</string>
    <string name="certificates_issue_button">प्रमाणपत्र बनाएँ</string>
    <string name="certificates_verify_button">प्रमाणपत्र जाँचें</string>

    <!-- QR code screen -->
    <string name="certificate_qr_title">प्रमाणपत्र क्यूआर कोड</string>
