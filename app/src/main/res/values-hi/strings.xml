    <string name="fire_module_results_correct">सही निर्णय</string>
    <string name="fire_module_results_wrong">ग़लत निर्णय</string>
    <string name="fire_module_results_time">लगा समय</string>
    <string name="fire_module_results_passed_advice">आपने सही अग्निशामक चुना और चिह्नों का पालन किया। यह अभ्यास समय-समय पर दोहराएँ: असली धुएँ में सोचने का समय नहीं मिलता।</string>
    <string name="fire_module_results_failed_advice">दोबारा कोशिश करने से पहले स्पष्टीकरण फिर पढ़ें। सिलेंडर का रंग बताता है कि उसमें क्या है: काला यानी CO₂, क्रीम यानी फोम, लाल यानी पानी।</string>
    <string name="fire_module_retry">फिर कोशिश करें</string>
    <string name="fire_module_next_module">अगला मॉड्यूल</string>

